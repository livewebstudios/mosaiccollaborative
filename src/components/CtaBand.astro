---
import Icon from "./Icon.astro";

// Round 2 (Oct 2026): one closing band on every page. One headline, one button, nothing else.
const headingId = "cta-h";
---

<section class="section section-dark cta-band" aria-labelledby={headingId}>
  {/* Procedural triangles, each drifting and rotating on its own (assets/tools/cta_triangles.py,
      36s seamless loop). Reduced motion keeps the poster. */}
  <div class="cta-media" aria-hidden="true">
    <video
      data-autoplay
      muted
      playsinline
      loop
      preload="metadata"
      poster="/media/video/mosaic_cta_triangles_900p-poster.jpg"
      width="1600"
      height="904"
    >
      <source src="/media/video/mosaic_cta_triangles_900p.webm" type="video/webm" />
      <source src="/media/video/mosaic_cta_triangles_900p.mp4" type="video/mp4" />
    </video>
    <div class="cta-scrim"></div>
  </div>

  <div class="container cta-inner">
    <h2 id={headingId} data-reveal>Which of these sounds like you?</h2>
    <p class="cta-actions" data-reveal>
      <a class="btn btn-on-dark" href="/contact/">
        <span class="btn-tri" aria-hidden="true"><Icon name="triangle" size={9} /></span>
        Let's talk
      </a>
    </p>
  </div>
</section>

<style>
  .cta-band { position: relative; overflow: hidden; isolation: isolate; }

  .cta-media { position: absolute; inset: 0; z-index: -1; }
  .cta-media video { width: 100%; height: 100%; object-fit: cover; }
  .cta-scrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 50%, rgba(20, 35, 58, 0.72) 25%, rgba(20, 35, 58, 0.4) 80%);
  }

  .cta-inner { text-align: center; display: grid; justify-items: center; gap: var(--space-32); }
  .cta-inner h2 { font-size: var(--step-3); max-width: 18ch; }
  .cta-actions { margin: 0; }
</style>
