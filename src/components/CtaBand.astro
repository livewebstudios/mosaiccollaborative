---
import Icon from "./Icon.astro";
import MosaicField from "./MosaicField.astro";

// One closing band on every page: one headline, one button. Round 3 brings back a
// per-page headline (Roz's wording) and adds the slanted tile strip from deck slide 2.
// The strip lives here and nowhere else (Jon's call). The drifting triangles video went:
// behind a full-opacity strip it read as two competing patterns.
interface Props {
  heading?: string;
}

const { heading = "Need a new perspective?" } = Astro.props;
const headingId = "cta-h";
---

<section class="section section-dark cta-band" aria-labelledby={headingId}>
  <div class="cta-strip" aria-hidden="true" data-break data-break-angle="20">
    <MosaicField cols={4} rows={14} cell={72} density={1} seed={202} stroke="#FAF0E0" gap={2} />
  </div>

  <div class="container cta-inner">
    <h2 id={headingId} data-reveal>{heading}</h2>
    <p class="cta-actions" data-reveal>
      <a class="btn btn-on-dark" href="/contact/">
        <span class="btn-tri" aria-hidden="true"><Icon name="triangle" size={9} /></span>
        Let's talk
      </a>
    </p>
  </div>
</section>

<style>
  .cta-band { position: relative; overflow: hidden; isolation: isolate; }

  /* A tall, narrow field rotated 20 degrees. The band clips its sides into a
     parallelogram and the mask fades both ends. Mobile: behind the heading, faint. */
  .cta-strip {
    position: absolute;
    z-index: -1;
    top: 50%;
    left: 50%;
    width: 200px;
    opacity: 0.35;
    pointer-events: none;
    transform: translate(-50%, -50%) rotate(20deg);
    mask-image: linear-gradient(180deg, transparent 20%, #000 38%, #000 62%, transparent 80%);
  }
  .cta-strip :global(svg) { width: 100%; height: auto; }


  @media (min-width: 1024px) {
    .cta-strip {
      left: auto;
      right: 9%;
      width: 260px;
      opacity: 0.9;
      pointer-events: auto;
      transform: translateY(-50%) rotate(20deg);
    }
  }

  .cta-inner { text-align: center; display: grid; justify-items: center; gap: var(--space-32); }
  .cta-inner h2 { font-size: var(--step-3); max-width: 18ch; }
  .cta-actions { margin: 0; }
  @media (min-width: 1024px) {
    /* Keep the heading clear of the strip in the right third. */
    .cta-inner { padding-right: 22%; }
  }
</style>
