---
import { Image } from "astro:assets";
import { site } from "../data/site";
import logoReversed from "../assets/logo/mosaic_logo_lockup_reversed.png";
import MosaicField from "./MosaicField.astro";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
const [taglineHead, taglineTail] = site.tagline.split("thrives");
const hasEmail = !site.email.startsWith("TODO");
---

<footer class="site-footer section-dark">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a class="footer-logo" href="/" aria-label={`${site.name}, home`}>
        <Image src={logoReversed} alt={site.name} widths={[160, 320]} sizes="160px" loading="lazy" />
      </a>
      <p class="display footer-tagline">{taglineHead}<em class="emphasis">thrives</em>{taglineTail}</p>
      <p class="eyebrow-plain">{site.strapline}</p>
    </div>

    <nav class="footer-col" aria-label="Footer">
      <h2 class="eyebrow-plain">EXPLORE</h2>
      <ul>
        {site.nav.map((item) => <li><a href={item.href}>{item.label.toUpperCase()}</a></li>)}
      </ul>
    </nav>

    <div class="footer-col">
      <h2 class="eyebrow-plain">CONTACT</h2>
      <ul>
        {hasEmail ? (
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        ) : (
          <li><a href="/contact/">LET'S TALK</a></li>
        )}
        <!-- TODO: confirm with Roz. Direct email address for the site. -->
        <li class="footer-location">{site.location}</li>
        {site.linkedinCompany && (
          <li>
            <a class="footer-linkedin" href={site.linkedinCompany} rel="noopener noreferrer" target="_blank">
              <Icon name="linkedin" size={16} /> LINKEDIN
            </a>
          </li>
        )}
        <!-- TODO: confirm with Roz. LinkedIn company page URL. -->
      </ul>
    </div>
  </div>

  <div class="container">
    <div class="footer-rule" data-reveal>
      <svg viewBox="0 0 100 1" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <line class="draw draw-long" x1="0" y1="0.5" x2="100" y2="0.5" pathLength="100" />
      </svg>
    </div>
    <div class="footer-legal">
      <p class="small">&copy; {year} {site.name}. All rights reserved.</p>
      <ul class="footer-legal-links">
        <li><a href="/privacy/">PRIVACY</a></li>
        <li><span class="footer-credit">Powered by <a href="https://livewebstudios.com" target="_blank" rel="noopener">Live Web Studios</a></span></li>
        <li>
          <a class="footer-badge" href="https://livewebstudios.com" target="_blank" rel="noopener">
            <img src="/images/verifiedsecured.png" alt="Verified and Secured by Live Web Studios" width="150" height="37" loading="lazy" />
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer-field" aria-hidden="true">
    <MosaicField cols={6} rows={4} cell={80} density={0.5} seed={19} opacity={0.18} />
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding-block: var(--space-64) var(--space-40);
    overflow: hidden;
  }
  .footer-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-40);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .footer-inner { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .footer-inner { grid-template-columns: 1.6fr 1fr 1.2fr; } }

  /* Reversed lockup: navy parts recolored to linen so it reads on the navy footer. */
  .footer-logo { display: inline-block; margin-bottom: var(--space-24); }
  .footer-logo img { width: 160px; height: auto; }

  /* The footer stays Inter (round 3), so the tagline drops the serif. */
  .footer-tagline {
    font-family: var(--font-sans);
    font-weight: 460;
    font-size: var(--step-2);
    max-width: 16ch;
    letter-spacing: -0.022em;
    color: var(--color-linen);
    margin-bottom: 1rem;
  }

  .footer-col ul { list-style: none; margin: var(--space-16) 0 0; padding: 0; }
  .footer-col li + li { margin-top: var(--space-12); }
  .footer-col a {
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--color-linen);
    opacity: 0.75;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }
  .footer-col a:hover, .footer-col a:focus-visible { opacity: 1; border-bottom-color: var(--color-gold); }
  .footer-linkedin { display: inline-flex; align-items: center; gap: 0.5em; }
  .footer-location { font-size: 0.875rem; opacity: 0.75; max-width: 30ch; }

  /* Round 4: the gold rule is an SVG line laid once when the footer reveals. The rule
     itself does not fade or rise; only the line draws. */
  .footer-rule { margin-block: var(--space-64) var(--space-24); }
  :global(html.motion-ok) .footer-rule[data-reveal] { opacity: 1; translate: none; rotate: none; }
  .footer-rule svg { display: block; width: 100%; height: 1px; overflow: visible; }
  .footer-rule line { stroke: var(--color-gold); stroke-width: 1; }
  .footer-legal {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .footer-legal p { opacity: 0.75; }
  .footer-legal-links { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; list-style: none; margin: 0; padding: 0; }
  .footer-legal-links a {
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .footer-legal-links a:hover { border-bottom-color: var(--color-gold); }

  .footer-credit {
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.65);
  }
  .footer-legal-links .footer-credit a {
    color: inherit;
    letter-spacing: 0;
    text-decoration: underline;
    text-underline-offset: 2px;
    border-bottom: 0;
  }
  .footer-legal-links .footer-credit a:hover,
  .footer-legal-links .footer-credit a:focus-visible { color: #fff; }
  .footer-legal-links .footer-badge { display: block; border-bottom: 0; }
  /* Native size so the mark stays crisp. */
  .footer-badge img {
    width: 150px;
    height: 37px;
  }

  .footer-field {
    position: absolute;
    right: -6%;
    bottom: -20%;
    width: min(46%, 520px);
    pointer-events: none;
    mask-image: radial-gradient(ellipse at 60% 40%, #000 30%, transparent 72%);
  }
</style>
