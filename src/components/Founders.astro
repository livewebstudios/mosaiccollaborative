---
/**
 * Founders: photo, name, title and a LinkedIn link for each founder, plus the three
 * bullets on About. "compact" is the Home version (three across, no bullets, each photo
 * links to /about/). "full" is the About version: larger photos, alternating sides.
 * Same data from team.ts.
 */
import Icon from "./Icon.astro";
import { team } from "../data/team";

interface Props {
  variant?: "compact" | "full";
  /** Heading level for each founder's name, so it nests under the section heading. */
  level?: 2 | 3;
}

const { variant = "compact", level = 3 } = Astro.props;
const Name = level === 2 ? "h2" : "h3";
const full = variant === "full";
// The headshots are 418px squares (round 3). Rendered at most 300px on About and 220px
// on Home, so they stay at or above 1.4x and are never upscaled.
const size = 418;
const initials = (name: string) => name.split(" ").slice(0, 2).map((w) => w[0]).join("");
---

<ul class:list={["founders-list", variant]} data-reveal-stagger>
  {team.map((member) => (
    <li class="founder" data-accent={member.accent} data-reveal>
      <div class="founder-photo">
        {full ? (
          <div class="team-photo">
            {member.photo ? (
              <img
                src={`/media/img/team/${member.photo}`}
                alt={`${member.name}, ${member.title}`}
                width={size}
                height={size}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <p class="team-initials" aria-hidden="true">{initials(member.name)}</p>
            )}
          </div>
        ) : (
          <a class="team-photo team-photo-link piece" href="/about/" aria-label={`About ${member.name}`}>
            {member.photo ? (
              <img
                src={`/media/img/team/${member.photo}`}
                alt=""
                width={size}
                height={size}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="team-initials" aria-hidden="true">{initials(member.name)}</span>
            )}
          </a>
        )}
      </div>

      <div class="founder-body">
        <Name class="founder-name">{member.name}</Name>
        <p class="founder-title">{member.title}</p>
        {member.linkedin && (
          <p class="founder-link">
            <a class="link-arrow" href={member.linkedin} rel="noopener noreferrer" target="_blank">
              <Icon name="linkedin" size={15} /> LinkedIn
            </a>
          </p>
        )}
        {full && (
          <ul class="tri-list founder-bullets">
            {member.bullets.map((b) => <li>{b}</li>)}
          </ul>
        )}
      </div>
    </li>
  ))}
</ul>
<!-- TODO: confirm with Roz. Full-size originals of Deb's and Amalia's headshots for retina. -->

<style>
  .founders-list { list-style: none; margin: 0; padding: 0; display: grid; }
  .founder p { margin: 0; }
  .founder-body { display: grid; gap: var(--space-12); align-content: start; }
  .founder-name { font-size: var(--step-2); color: var(--color-navy); }
  /* Round 3: titles about two-thirds the name size, as in the deck. */
  .founder-title {
    font-size: var(--step-1);
    font-weight: 500;
    color: var(--color-navy);
    line-height: 1.35;
  }
  .founder-bullets { margin-top: var(--space-8); max-width: 52ch; }

  /* Compact: three across from 768px, photo above the words. */
  .compact { gap: clamp(3rem, 5vw, 4rem); }
  @media (min-width: 768px) { .compact { grid-template-columns: repeat(3, 1fr); } }
  .compact .founder { display: grid; gap: var(--space-24); align-content: start; }
  /* Photos never render past 220px on Home, so the 420px headshots stay above 1.9x. */
  .compact .team-photo { width: min(100%, 220px); }
  /* Round 4: piece-lift on the photo only (global .piece): it lifts and the halo fades in. */
  .team-photo-link { display: block; overflow: visible; }
  /* The halo sits outside the circle, so the photo clips itself instead of the link. */
  .team-photo-link > :global(*) { border-radius: 50%; overflow: hidden; }

  /* Full: alternating left and right on desktop, stacked on mobile. */
  .full { gap: clamp(4rem, 8vw, 7rem); }
  .full .founder { display: grid; gap: clamp(1.5rem, 3vw, 3rem); align-items: start; }
  @media (min-width: 768px) {
    .full .founder { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .full .founder:nth-child(even) .founder-photo { order: 2; }
  }
  .full .founder-photo { display: flex; justify-content: center; }
  .full .team-photo { width: clamp(11rem, 26vw, 300px); }
  .full .founder-name { font-size: var(--step-3); }
</style>
