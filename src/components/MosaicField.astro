---
/**
 * MosaicField: the core brand device.
 * A grid of right-triangle tiles with thin white grout, generated deterministically
 * from a seed so every build produces identical markup.
 */
interface Props {
  cols?: number;
  rows?: number;
  cell?: number;
  density?: number;
  seed?: number;
  palette?: string[];
  class?: string;
  drift?: boolean;
  opacity?: number;
}

const {
  cols = 8,
  rows = 6,
  cell = 60,
  density = 1,
  seed = 7,
  palette,
  class: className = "",
  drift = false,
  opacity = 1,
} = Astro.props;

const COLORS = ["#1E3A5F", "#7A9BB5", "#8B1A3A", "#D4942A"];
// Weighted per the design system: navy 35, slate 30, burgundy 20, gold 15.
const WEIGHTS = [35, 30, 20, 15];
const colors = palette ?? COLORS;

// Mulberry32: small, fast, deterministic.
function rng(s: number) {
  let a = s >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = rng(seed);
const total = WEIGHTS.reduce((a, b) => a + b, 0);

function pick(r: number): string {
  if (palette) return colors[Math.floor(r * colors.length) % colors.length]!;
  let acc = 0;
  const target = r * total;
  for (let i = 0; i < WEIGHTS.length; i++) {
    acc += WEIGHTS[i]!;
    if (target <= acc) return COLORS[i]!;
  }
  return COLORS[0]!;
}

type Tile = { points: string; fill: string; i: number };
const tiles: Tile[] = [];
let index = 0;

for (let r = 0; r < rows; r++) {
  for (let c = 0; c < cols; c++) {
    const x = c * cell;
    const y = r * cell;
    const flip = (r + c) % 2 === 0;
    // Each square cell splits along one diagonal into two right triangles.
    const pair = flip
      ? [`${x},${y} ${x + cell},${y} ${x},${y + cell}`, `${x + cell},${y} ${x + cell},${y + cell} ${x},${y + cell}`]
      : [`${x},${y} ${x + cell},${y} ${x + cell},${y + cell}`, `${x},${y} ${x + cell},${y + cell} ${x},${y + cell}`];
    for (const points of pair) {
      const keep = rand();
      const hue = rand();
      if (keep > density) { index++; continue; }
      tiles.push({ points, fill: pick(hue), i: index++ });
    }
  }
}

const w = cols * cell;
const h = rows * cell;
---

<svg
  class={`mosaic-field ${drift ? "tile-drift" : ""} ${className}`}
  viewBox={`0 0 ${w} ${h}`}
  width={w}
  height={h}
  style={`opacity:${opacity}`}
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="xMidYMid slice"
>
  <g stroke="#FFFFFF" stroke-width="2" stroke-linejoin="round">
    {tiles.map((t) => (
      <polygon data-tile={t.i} style={`--i:${t.i}`} fill={t.fill} points={t.points} />
    ))}
  </g>
</svg>
