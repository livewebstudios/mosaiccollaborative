---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { gen } from "../lib/gen";
import CtaBand from "../components/CtaBand.astro";
import Founders from "../components/Founders.astro";
import { team } from "../data/team";
import { site } from "../data/site";

const title = "About the Founders | The Mosaic Collaborative";
const description =
  "Meet founders Roz Cohen, PhD, Debra DeFrancesco and Amalia Egri Freedman, and the beliefs that shape every engagement.";

const beliefs = [
  {
    lead: "We strengthen organizations while solving problems.",
    body: "Every engagement should leave an organization more capable than when we arrived. We build leadership, systems, and organizational capacity that support long-term success. We equip leaders with practical tools, shared approaches, and repeatable practices that become the way the organization works. Our work is measured by the strength we leave behind.",
  },
  {
    lead: "We uncover the right answers together.",
    body: "Every organization is unique. We combine deep inquiry, diverse perspectives, and practical experience to develop solutions tailored to your people, culture, and goals.",
  },
  {
    lead: "We connect strategy to execution.",
    body: "Strategies that can't be implemented are just notes on a whiteboard. We help organizations translate vision into action by aligning priorities, decision-making, and accountability.",
  },
  {
    lead: "We design solutions that consider the whole organization.",
    body: "Leadership, culture, operations, and organizational structure are interconnected. Lasting change requires understanding how the pieces work together. We design solutions that strengthen the whole organization, not just individual units or functions.",
  },
];

const schema = [
  ...team.map((m) => ({
    "@context": "https://schema.org",
    "@type": "Person",
    name: m.name,
    jobTitle: m.title,
    worksFor: { "@type": "Organization", name: site.name, url: site.url },
    ...(m.photo ? { image: new URL(`/media/img/team/${m.photo}`, site.url).href } : {}),
    ...(m.linkedin ? { sameAs: [m.linkedin] } : {}),
  })),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.url + "/" },
      { "@type": "ListItem", position: 2, name: "About", item: site.url + "/about/" },
    ],
  },
];

---

<Base title={title} description={description} path="/about/" schema={schema}>
  <!-- Section 1: the three of us -->
  <section class="section founders" aria-labelledby="about-h">
    <div class="container">
      <h1 id="about-h" class="about-h" data-reveal>We know leadership because we've lived it</h1>
      <Founders variant="full" level={2} />
    </div>
  </section>

  <!-- Section 2: beliefs. The change from linen to the gray ground is the divider. -->
  <section class="section section-gray beliefs has-bg" aria-labelledby="beliefs-h">
    <div class="section-bg" aria-hidden="true">
      <Image src={gen("foundation")} alt="" widths={[800, 1400, 2000]} sizes="100vw" />
    </div>
    <div class="container beliefs-inner">
      <div class="beliefs-sticky">
        <h2 id="beliefs-h" data-reveal>What we believe informs what we do</h2>
      </div>
      <ol class="beliefs-list" data-beliefs>
        {beliefs.map((belief, i) => (
          <li class="belief card" data-accent={["navy", "slate", "gold", "burgundy"][i]} data-reveal>
            {/* Deck order: the body first, the highlighted sentence last. */}
            <p>{belief.body} <strong class="belief-lead">{belief.lead}</strong></p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .founders { padding-top: calc(var(--section-y) + 8.5rem); }
  .about-h { max-width: 18ch; margin-bottom: clamp(4rem, 8vw, 7rem); }

  /* Beliefs */
  .beliefs-inner { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  @media (min-width: 1024px) { .beliefs-inner { grid-template-columns: 5fr 7fr; align-items: start; } }
  .beliefs-sticky { display: grid; gap: 1rem; align-content: start; }
  @media (min-width: 1024px) { .beliefs-sticky { position: sticky; top: 20vh; } }
  .beliefs-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--grid-gap); }
  .belief p { max-width: 60ch; }
  .belief-lead { font-weight: 600; color: var(--color-navy); }
</style>
