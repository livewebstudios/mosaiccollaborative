---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { gen } from "../lib/gen";
import CtaBand from "../components/CtaBand.astro";
import Founders from "../components/Founders.astro";
import MosaicGlow from "../components/MosaicGlow.astro";
import { team } from "../data/team";
import { site } from "../data/site";

const title = "About the Founders | The Mosaic Collaborative";
const description =
  "Meet founders Roz Cohen, PhD, Debra DeFrancesco and Amalia Egri Freedman, and the beliefs that shape every engagement.";

const beliefs = [
  {
    lead: "We strengthen organizations while solving problems.",
    image: "belief-strengthen",
    alt: "A small arch built from navy, slate, burgundy and gold triangle tiles standing on linen.",
    body: "Every engagement should leave an organization more capable than when we arrived. We build leadership, systems, and organizational capacity that support long-term success. We equip leaders with practical tools, shared approaches, and repeatable practices that become the way the organization works. Our work is measured by the strength we leave behind.",
  },
  {
    lead: "We uncover the right answers together.",
    image: "belief-together",
    alt: "A magnifying glass over four triangle tiles fitted into one shape, loose tiles of each color around it.",
    body: "Every organization is unique. We combine deep inquiry, diverse perspectives, and practical experience to develop solutions tailored to your people, culture, and goals.",
  },
  {
    lead: "We connect strategy to execution.",
    image: "belief-execution",
    alt: "A pencil sketch of a triangle pattern beside the same pattern built in colored tiles.",
    body: "Strategies that can't be implemented are just notes on a whiteboard. We help organizations translate vision into action by aligning priorities, decision-making, and accountability.",
  },
  {
    lead: "We design solutions that consider the whole organization.",
    image: "belief-whole",
    alt: "A complete square mosaic of triangle tiles with one gold tile lifted to show how it fits.",
    body: "Leadership, culture, operations, and organizational structure are interconnected. Lasting change requires understanding how the pieces work together. We design solutions that strengthen the whole organization, not just individual units or functions.",
  },
];

const schema = [
  ...team.map((m) => ({
    "@context": "https://schema.org",
    "@type": "Person",
    name: m.name,
    jobTitle: m.title,
    worksFor: { "@type": "Organization", name: site.name, url: site.url },
    ...(m.photo ? { image: new URL(`/media/img/team/${m.photo}`, site.url).href } : {}),
    ...(m.linkedin ? { sameAs: [m.linkedin] } : {}),
  })),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.url + "/" },
      { "@type": "ListItem", position: 2, name: "About", item: site.url + "/about/" },
    ],
  },
];

---

<Base title={title} description={description} path="/about/" schema={schema}>
  <!-- Section 1: the three of us -->
  <section class="section founders" aria-labelledby="about-h">
    <div class="container">
      <h1 id="about-h" class="about-h" data-reveal>We know leadership because we've lived it</h1>
      <Founders variant="full" level={2} />
      <!-- The one count-up on the site (Deb asked on the call). The final number is in the
           markup, so JS off and reduced motion read 75; the animated copy is hidden from
           screen readers. -->
      <p class="experience" data-reveal data-draw>
        Together we bring over <span class="sr-only">75</span><span aria-hidden="true" data-countup="75">75</span> years of experience to our clients.
        <svg class="experience-line" viewBox="0 0 100 2" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <line class="draw draw-long" x1="0" y1="1" x2="100" y2="1" pathLength="100" />
        </svg>
      </p>
    </div>
  </section>

  <!-- Section 2: beliefs. The change from linen to the gray ground is the divider. -->
  <section class="section section-gray beliefs has-bg has-glow" aria-labelledby="beliefs-h">
    <div class="section-bg" aria-hidden="true">
      <Image src={gen("foundation")} alt="" widths={[800, 1400, 2000]} sizes="100vw" />
    </div>
    <MosaicGlow position="bottom-left" seed={181} />
    <div class="container beliefs-inner">
      <div class="beliefs-sticky">
        <h2 id="beliefs-h" data-reveal>What we believe informs what we do</h2>
        <!-- The pieces aligning, so the column is not a wall of text. Assembled without JS. -->
        <!-- Nov 1: Jon's tile plate photo replaces the assembling tile cluster here. -->
        <Image
          class="beliefs-photo"
          src={gen("belief-plate")}
          alt="A round plate laid with navy, slate, burgundy and gold triangle tiles on linen."
          widths={[360, 720]}
          sizes="(min-width: 1024px) 360px, 60vw"
          format="jpg"
          quality={80}
          loading="lazy"
          data-reveal
        />
      </div>
      <ol class="beliefs-list" data-beliefs data-reveal-stagger>
        {beliefs.map((belief, i) => (
          <li class="belief piece" data-accent={["navy", "burgundy", "gold", "moss"][i]} data-reveal>
            <svg class="belief-mark reseat" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
              <polygon class="draw" points="1,1 39,1 39,39" pathLength="100" />
            </svg>
            {/* Deck order: the body first, the highlighted sentence last. */}
            <p>{belief.body} <strong class="belief-lead">{belief.lead}</strong></p>
            <Image
              class="belief-photo"
              src={gen(belief.image)}
              alt={belief.alt}
              widths={[560, 1120]}
              sizes="(min-width: 1024px) 40vw, 90vw"
              format="jpg"
              quality={78}
              loading="lazy"
            />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand heading="Need a new perspective?" />
</Base>

<style>
  /* Clip sideways only: the tile fields behind the photos run past the column. */
  .founders { padding-top: calc(var(--section-y) + 8.5rem); overflow-x: clip; }
  .about-h { max-width: 18ch; margin-bottom: clamp(4rem, 8vw, 7rem); }
  .experience {
    margin: clamp(5rem, 10vw, 8rem) auto 0;
    max-width: 24ch;
    text-align: center;
    text-wrap: balance;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-3);
    line-height: 1.15;
    color: var(--color-navy);
  }
  .experience [data-countup] { font-variant-numeric: tabular-nums; }

  /* Beliefs */
  .beliefs-inner { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  @media (min-width: 1024px) { .beliefs-inner { grid-template-columns: 5fr 7fr; align-items: start; } }
  .beliefs-sticky { display: grid; gap: 1rem; align-content: start; }
  @media (min-width: 1024px) { .beliefs-sticky { position: sticky; top: 20vh; } }
  .beliefs-photo {
    display: block;
    width: min(100%, 360px);
    height: auto;
    margin-top: var(--space-24);
    border-radius: var(--radius-sm);
  }
  @media (max-width: 1023px) { .beliefs-photo { width: min(60%, 260px); } }
  .beliefs-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--grid-gap); }
  .belief p { max-width: 60ch; }
  /* Nov 1: a photo under each belief, inside the same padding as the text. */
  .belief-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-top: clamp(var(--space-20), 2.4vw, var(--space-32));
    border-radius: var(--radius-sm);
  }
  /* Round 3: the closing line of each belief in burgundy (Roz's "maroon"), bold, larger. */
  .belief-lead { font-weight: 600; font-size: var(--step-1); color: var(--color-burgundy); }
  /* Round 4: the belief card keeps the round 3 cut-tile shape, but its corner mark is a
     drawn SVG triangle (grout-draw, three edges) and the hover is piece-lift: the card
     lifts, the halo fades in and the mark breathes out from the corner and reseats.
     The round 3 scale-and-turn hover is gone. */
  .belief {
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: var(--radius-tile) 0 var(--radius-tile) 0;
    padding: clamp(var(--space-20), 2.4vw, var(--space-32));
    padding-right: clamp(3.5rem, 6vw, 4.5rem);
  }
  .belief-mark {
    position: absolute;
    top: 0;
    right: 0;
    width: 40px;
    height: 40px;
    overflow: visible;
    transform-origin: 100% 0;
    transition: transform 420ms var(--ease-out-expo);
  }
  .belief-mark polygon {
    --rx: 1;
    --ry: -1;
    fill: color-mix(in oklab, var(--accent) 18%, transparent);
    stroke: var(--accent);
    stroke-width: var(--stroke-grout);
    stroke-linejoin: round;
    transition: stroke-width 420ms var(--ease-out-expo);
  }
  /* Hover (Jon, Nov 1): the corner tile slides down over the card along its own
     diagonal to twice its size, and backs out when the pointer leaves. The stroke
     halves so the edge stays the same weight at 2x. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .belief:hover .belief-mark { transform: scale(2); }
    .belief:hover .belief-mark polygon { stroke-width: calc(var(--stroke-grout) / 2); }
  }

  /* The underline under the whole 75 line: the one long draw on this page, laid as the
     count starts (motion.ts adds .is-drawn to this [data-draw] host). */
  .experience-line { display: block; width: min(60%, 16rem); height: 2px; margin: 1.25rem auto 0; overflow: visible; }
  .experience-line line { stroke: var(--color-burgundy); stroke-width: 2; }
</style>
