---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import CtaBand from "../../components/CtaBand.astro";
import MosaicField from "../../components/MosaicField.astro";
import Icon from "../../components/Icon.astro";
import { journeys } from "../../data/journeys";
import { site } from "../../data/site";

export const getStaticPaths = (() =>
  journeys.map((journey) => ({
    params: { journey: journey.slug },
    props: { journey },
  }))) satisfies GetStaticPaths;

const { journey } = Astro.props;
const others = journeys.filter((j) => j.slug !== journey.slug);
const path = `/how-we-work/${journey.slug}/`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: journey.name,
    serviceType: journey.promise,
    description: journey.framework,
    category: "Custom Offerings",
    provider: { "@type": "Organization", name: site.name, url: site.url },
    areaServed: { "@type": "Country", name: "United States" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.url + "/" },
      { "@type": "ListItem", position: 2, name: "Services", item: site.url + "/services/" },
      { "@type": "ListItem", position: 3, name: journey.name, item: site.url + path },
    ],
  },
];
---

<Base
  title={journey.metaTitle}
  description={journey.metaDescription}
  path={path}
  schema={schema}
  bodyClass="journey-page"
>
  <div data-accent={journey.accent}>
    <!-- Hero -->
    <section class="section journey-hero" aria-labelledby="journey-h" data-parallax-scope>
      <div class="journey-hero-field" aria-hidden="true" data-parallax="0.08">
        <MosaicField cols={5} rows={4} cell={96} density={0.45} seed={journey.number.charCodeAt(1) * 13} drift />
      </div>

      <div class="container journey-hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/services/">SERVICES</a></li>
            <li><a href="/services/#custom-offerings">CUSTOM OFFERINGS</a></li>
            <li aria-current="page">{journey.name.toUpperCase()}</li>
          </ol>
        </nav>

        <p class="journey-number display-xl" aria-hidden="true" data-parallax="-0.06">{journey.number}</p>
        <h1 id="journey-h" data-reveal>{journey.name}</h1>
        <p class="journey-promise" data-reveal>{journey.promise}</p>
        <blockquote class="journey-quote quote" data-reveal>
          <p>{`"${journey.quote}"`}</p>
        </blockquote>
      </div>
    </section>

    <!-- Problem -->
    <section class="section section-linen-dark symptoms" aria-labelledby="symptoms-h">
      <div class="container symptoms-inner">
        <div class="symptoms-head">
          <p class="eyebrow" data-reveal>Sound familiar?</p>
          <h2 id="symptoms-h" data-reveal>You might be hearing this</h2>
        </div>
        <ul class="tri-list symptom-list" data-reveal-stagger="90">
          {journey.symptoms.map((symptom) => <li data-reveal>{symptom}</li>)}
        </ul>
      </div>
    </section>

    <!-- Solution framework and deliverable -->
    <section class="section solution" aria-labelledby="solution-h">
      <div class="container solution-inner">
        <div class="solution-head">
          <p class="eyebrow" data-reveal>How we help</p>
          <h2 id="solution-h" data-reveal>Our approach</h2>
        </div>
        <div class="solution-body">
          <p class="solution-text" data-reveal>{journey.framework}</p>
          <p class="deliverable-line" data-reveal>
            <span class="deliverable-label">Deliverable:</span>
            <span class="deliverable-value">{journey.deliverable}</span>
          </p>
        </div>
      </div>
    </section>

    <!-- Other journeys -->
    <section class="section section-gray others" aria-labelledby="others-h">
      <div class="container others-inner">
        <div class="others-head">
          <p class="eyebrow" data-reveal>Other journeys</p>
          <h2 id="others-h" data-reveal>Where else we might start</h2>
        </div>

        <div class="others-list">
          {others.map((other, i) => (
            <div class="accordion-row" data-accent={other.accent} data-open="true" data-collapse-index={i}>
              <h3>
                <button
                  class="accordion-trigger"
                  type="button"
                  aria-expanded="true"
                  aria-controls={`panel-${other.slug}`}
                  id={`trigger-${other.slug}`}
                >
                  <span class="accordion-label">
                    <span class="accordion-number" aria-hidden="true">{other.number}</span>
                    {other.name}
                  </span>
                  <span class="accordion-icon" aria-hidden="true"><Icon name="plus" size={20} /></span>
                </button>
              </h3>
              <div class="accordion-panel" id={`panel-${other.slug}`} role="region" aria-labelledby={`trigger-${other.slug}`}>
                <div>
                  <div class="accordion-content">
                    <p class="accordion-promise">{other.promise}</p>
                    <p class="quote accordion-quote">{`"${other.ceoQuestion}"`}</p>
                    <p>{other.homeBlurb}</p>
                    <a class="link-arrow" href={`/how-we-work/${other.slug}/`}>
                      Explore {other.name} <Icon name="arrow" size={15} />
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <CtaBand
      heading={`Does ${journey.name} sound like your organization?`}
      body="Tell us what's going on. We'll tell you honestly whether we can help and where we'd start."
    />
  </div>
</Base>

<style>
  /* Hero */
  .journey-hero {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--section-y) + 8.5rem);
    background: var(--accent-tint);
  }
  .journey-hero-field {
    position: absolute;
    right: -10%;
    top: 14%;
    width: min(46%, 560px);
    opacity: 0.85;
    pointer-events: none;
    mask-image: radial-gradient(ellipse at 62% 48%, #000 26%, transparent 72%);
  }
  .journey-hero-inner { position: relative; z-index: 1; }
  /* Centered in the 1200 track like the header; only the text measure is capped. */
  .journey-hero-inner > * { max-width: 58rem; }

  .breadcrumb ol {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: var(--step--1);
    letter-spacing: 0.12em;
  }
  .breadcrumb li + li::before { content: "/"; margin-right: 0.6rem; opacity: 0.45; }
  .breadcrumb a { text-decoration: none; border-bottom: 1px solid var(--rule); }
  .breadcrumb [aria-current="page"] { color: var(--accent-text); }

  .journey-number {
    font-family: var(--font-display);
    color: var(--accent-text);
    opacity: 0.28;
    margin: 0 0 -0.15em;
  }
  .journey-hero h1 { color: var(--accent-text); }
  .journey-promise { font-size: var(--step-1); font-weight: 500; margin-top: 0.75rem; }
  .journey-quote { margin-top: 2rem; max-width: 26ch; border-left: 3px solid var(--accent); padding-left: 1.25rem; }

  /* Symptoms */
  .symptoms-inner { display: grid; gap: clamp(2rem, 5vw, 4rem); }
  @media (min-width: 1024px) { .symptoms-inner { grid-template-columns: 4fr 8fr; align-items: start; } }
  .symptoms-head { display: grid; gap: 0.75rem; align-content: start; }
  @media (min-width: 1024px) { .symptoms-head { position: sticky; top: 8rem; } }
  .symptom-list { font-size: var(--step-1); line-height: 1.4; max-width: 46ch; }
  .symptom-list > li + li { margin-top: 1rem; }
  .symptom-list > li::before { top: 0.55em; }

  /* Solution */
  .solution-inner { display: grid; gap: clamp(2rem, 5vw, 4rem); }
  @media (min-width: 1024px) { .solution-inner { grid-template-columns: 4fr 8fr; align-items: start; } }
  .solution-head { display: grid; gap: 0.75rem; align-content: start; }
  .solution-body { display: grid; gap: clamp(1.5rem, 3vw, 2.25rem); max-width: 46ch; }
  .solution-text {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.3;
    letter-spacing: -0.014em;
    color: var(--color-navy);
  }
  /* Deliverable: one line, set as a label rather than another section heading. */
  .deliverable-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.6rem;
    row-gap: 0.2rem;
    padding-left: 0.9rem;
    border-left: 3px solid var(--accent);
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .deliverable-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-burgundy);
  }
  .deliverable-value { font-weight: 500; color: var(--accent-text); }

  /* Other journeys */
  .others-inner { display: grid; gap: clamp(2rem, 5vw, 4rem); }
  @media (min-width: 1024px) { .others-inner { grid-template-columns: 4fr 8fr; align-items: start; } }
  .others-head { display: grid; gap: 0.75rem; align-content: start; }
  @media (min-width: 1024px) { .others-head { position: sticky; top: 8rem; } }
  .others-list h3 { margin: 0; font-size: inherit; }
  .accordion-label { display: flex; align-items: baseline; gap: 1rem; }
  .accordion-number { font-size: var(--step-0); color: var(--accent-text); opacity: 0.6; }
  .accordion-content {
    display: grid;
    gap: 0.75rem;
    padding-bottom: clamp(1.25rem, 3vw, 2rem);
    max-width: 52ch;
  }
  .accordion-promise { font-weight: 500; color: var(--accent-text); }
  .accordion-quote { font-size: var(--step-1); }
</style>
