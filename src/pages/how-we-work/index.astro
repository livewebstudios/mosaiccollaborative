---
import Base from "../../layouts/Base.astro";
import CtaBand from "../../components/CtaBand.astro";
import MosaicField from "../../components/MosaicField.astro";
import Icon from "../../components/Icon.astro";
import { journeys } from "../../data/journeys";
import { site } from "../../data/site";

const title = "How We Work: Four Journeys for Organizational Change";
const description =
  "Clarify, Build, Activate, Reignite. Four focused consulting journeys, each standing on its own and leaving your organization stronger.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.url + "/" },
      { "@type": "ListItem", position: 2, name: "How We Work", item: site.url + "/how-we-work/" },
    ],
  },
];
---

<Base title={title} description={description} path="/how-we-work/" schema={schema}>
  <section class="section page-hero" aria-labelledby="hww-h">
    <div class="hero-field" aria-hidden="true">
      <MosaicField cols={5} rows={3} cell={92} density={0.4} seed={71} drift />
    </div>
    <div class="container page-hero-inner">
      <p class="eyebrow" data-reveal>How we work</p>
      <h1 id="hww-h" data-reveal>Our journey together</h1>
      <p class="lead" data-reveal>
        The Mosaic Collaborative offers a set of focused interventions around a specific organizational
        challenge. While our journeys complement each other, each stands on its own and leaves your
        organization stronger.
      </p>
    </div>
  </section>

  <section class="section ladder" aria-labelledby="ladder-h">
    <div class="container">
      <h2 id="ladder-h" class="sr-only">The four journeys</h2>
      <ol class="journey-ladder" data-reveal-stagger="110">
        {journeys.map((j, i) => (
          <li data-accent={j.accent} style={`--rung:${i}`} data-reveal>
            <a href={`/how-we-work/${j.slug}/`}>
              <span class="rung-number" aria-hidden="true">{j.number}</span>
              <span class="rung-body">
                <strong>{j.name}</strong>
                <span class="rung-promise">{j.promise}</span>
              </span>
              <span class="rung-arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-gray orientation" aria-labelledby="orientation-h">
    <div class="container">
      <div class="orientation-head">
        <p class="eyebrow" data-reveal>Conceptual orientation</p>
        <h2 id="orientation-h" data-reveal>Which journey is yours?</h2>
      </div>

      <div class="table-scroll">
        <table class="journey-table">
          <caption class="sr-only">
            The four journeys, the question each answers, its sources of friction and its solutions.
          </caption>
          <thead>
            <tr>
              <th scope="col">Journey</th>
              <th scope="col">The CEO is asking</th>
              <th scope="col">Sources of friction</th>
              <th scope="col">Solutions</th>
            </tr>
          </thead>
          <tbody>
            {journeys.map((j) => (
              <tr data-accent={j.accent}>
                <th scope="row"><a href={`/how-we-work/${j.slug}/`}>{j.name}</a></th>
                <td class="td-question">{`"${j.ceoQuestion}"`}</td>
                <td>{j.friction}</td>
                <td>{j.solutions}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Not sure which journey fits?"
    body="That's usually the first thing we figure out together."
  />
</Base>

<style>
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .page-hero { position: relative; overflow: hidden; padding-top: calc(var(--section-y) + 8.5rem); }
  .page-hero-inner { position: relative; z-index: 1; max-width: 58rem; margin-inline: 0; display: grid; gap: 1rem; }
  .hero-field {
    position: absolute;
    right: -8%;
    top: 22%;
    width: min(38%, 440px);
    pointer-events: none;
    opacity: 0.85;
    mask-image: radial-gradient(ellipse at 62% 48%, #000 28%, transparent 74%);
  }

  /* Descending diagonal staircase, mirroring the deck */
  .journey-ladder { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--grid-gap); }
  @media (min-width: 1024px) {
    .journey-ladder > li { margin-left: calc(var(--rung) * 7%); width: 72%; }
  }
  .journey-ladder a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 3vw, 2.25rem);
    background: #fff;
    border: 1px solid var(--rule);
    border-left: 6px solid var(--accent);
    border-radius: var(--radius-tile) 0 var(--radius-tile) 0;
    text-decoration: none;
    transition: transform 0.4s var(--ease-out-expo), box-shadow 0.4s var(--ease-out-expo);
  }
  .journey-ladder a:hover, .journey-ladder a:focus-visible {
    transform: translateX(8px);
    box-shadow: 0 18px 40px -26px rgba(20, 35, 58, 0.5);
  }
  .rung-number {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1;
    color: var(--accent-text);
    opacity: 0.45;
  }
  .rung-body { display: grid; gap: 0.35rem; }
  .rung-body strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-2);
    color: var(--color-navy);
  }
  .rung-promise { font-size: var(--step--1); }
  .rung-arrow { color: var(--accent-text); }

  .orientation-head { max-width: 40ch; margin-bottom: clamp(2rem, 4vw, 3rem); display: grid; gap: 0.75rem; }
  .table-scroll { overflow-x: auto; }

  .journey-table { width: 100%; border-collapse: collapse; min-width: 46rem; text-align: left; }
  .journey-table th, .journey-table td {
    padding: clamp(0.9rem, 2vw, 1.4rem);
    vertical-align: top;
    border-bottom: 1px solid var(--rule);
    font-size: var(--step--1);
  }
  .journey-table thead th {
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.75rem;
    color: var(--color-burgundy);
    border-bottom: 2px solid var(--color-navy);
  }
  .journey-table tbody th[scope="row"] {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-1);
    color: var(--accent-text);
    border-left: 4px solid var(--accent);
    white-space: nowrap;
  }
  .journey-table tbody th a { text-decoration: none; }
  .journey-table tbody th a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .journey-table tbody tr { background: #fff; }
  .td-question { font-family: var(--font-display); font-style: italic; font-size: var(--step-0); }

  /* Stacked cards on small screens */
  @media (max-width: 767px) {
    .journey-table { min-width: 0; }
    .journey-table thead { position: absolute; left: -9999px; }
    .journey-table tr {
      display: grid;
      gap: 0.35rem;
      margin-bottom: var(--grid-gap);
      border: 1px solid var(--rule);
      border-left: 4px solid var(--accent);
      border-radius: var(--radius-tile) 0 var(--radius-tile) 0;
      padding: 1rem;
    }
    .journey-table th, .journey-table td { border-bottom: 0; padding: 0.35rem 0; }
    .journey-table tbody th[scope="row"] { border-left: 0; }
    .journey-table td::before {
      content: attr(data-label);
      display: block;
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-burgundy);
      margin-bottom: 0.15rem;
    }
  }
</style>
