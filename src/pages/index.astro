---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import TwoWays from "../components/TwoWays.astro";
import Founders from "../components/Founders.astro";
import MosaicField from "../components/MosaicField.astro";
import MosaicGlow from "../components/MosaicGlow.astro";
import Icon from "../components/Icon.astro";
import { gen } from "../lib/gen";
import bookCover from "../assets/img/book/cover-front.jpg";
import { site } from "../data/site";
import { team } from "../data/team";

// The H1 is the tagline from site.ts, with "thrives" set as the emphasis word (round 3).
const [taglineHead, taglineTail] = site.tagline.split("thrives");
// Statement band cluster: linen, gold and slate read on navy.
const onNavy = ["#FAF0E0", "#D4942A", "#7A9BB5", "#FAF0E0", "#7A9BB5"];

// Round 2 (Oct 2026): one scroll of five bands plus the closing band. Much less content,
// much more white space.
const title = "The Mosaic Collaborative: Strategy & Leadership Consulting";
const description =
  "Strategy, leadership, and organizational consulting for companies at critical inflection points. We align the pieces so your business thrives.";

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: site.url,
  slogan: site.tagline,
  description,
  logo: new URL("/og.jpg", site.url).href,
  ...(site.email.startsWith("TODO") ? {} : { email: site.email }),
  areaServed: { "@type": "Country", name: "United States" },
  founder: team.map((m) => ({
    "@type": "Person",
    name: m.name,
    jobTitle: m.title,
  })),
};
---

<Base title={title} description={description} path="/" schema={schema}>
  <!-- Band 1: first screen -->
  <section class="hero" aria-labelledby="hero-h" data-parallax-scope>
    <div class="hero-media" aria-hidden="true">
      <video
        data-autoplay
        data-hold="4"
        data-rate="0.85"
        data-parallax="0.12"
        muted
        playsinline
        preload="metadata"
        poster="/media/video/mosaic_hero_light_tiles_720p-poster.jpg"
        width="1280"
        height="720"
      >
        <source src="/media/video/mosaic_hero_light_tiles_720p.webm" type="video/webm" />
        <source src="/media/video/mosaic_hero_light_tiles_720p.mp4" type="video/mp4" />
      </video>
      <div class="hero-scrim"></div>
      <!-- A darker blue layer that moves very slowly (round 3). Felt, not seen. -->
      <div class="hero-wash" aria-hidden="true">
        <span class="hero-wash-navy" data-drift="60" data-drift-travel="4"></span>
        <span class="hero-wash-slate" data-drift="75" data-drift-travel="4"></span>
      </div>
    </div>

    <div class="container hero-inner">
      <h1 id="hero-h" data-reveal>{taglineHead}<em class="emphasis">thrives</em>{taglineTail}</h1>
      <p class="lead" data-reveal style="--reveal-delay:140ms">
        Strategy, leadership, and organizational consulting for companies at critical inflection points.
      </p>
      <p class="hero-actions" data-reveal style="--reveal-delay:280ms">
        <a class="btn btn-primary" href="/contact/">
          <span class="btn-tri" aria-hidden="true"><Icon name="triangle" size={9} /></span>
          Let's talk
        </a>
        <a class="btn btn-secondary" href="/services/">Explore our services</a>
      </p>
    </div>

    <p class="scroll-cue" aria-hidden="true">
      <span class="scroll-cue-line"></span>
    </p>
  </section>

  <!-- Band 2: the big statement. Plain navy without JS or under reduced motion;
       otherwise it blends in from linen as it scrolls up (initStatement in motion.ts). -->
  <section class="section section-dark statement has-glow" aria-labelledby="statement-h" data-statement>
    <MosaicGlow position="bottom-left" palette="dark" seed={131} />
    <div class="container statement-inner">
      <h2 id="statement-h" class="statement-h" data-reveal>
        Whether you're pursuing an opportunity or responding to a challenge, we help you prepare your
        organization for what's next.
      </h2>
      <!-- The pieces aligning: tiles start scattered and settle into the block as the band
           scrolls in (initStatement). Assembled and still without JS or under reduced motion. -->
      <div class="statement-art" aria-hidden="true" data-assemble>
        <MosaicField cols={5} rows={4} cell={60} density={0.92} seed={149} palette={onNavy} stroke="#1E3A5F" />
      </div>
      <div class="statement-body">
        <p data-reveal>
          We work with companies facing challenges that don't have obvious answers.
          AI is reshaping the workforce. Growth has stalled, or is outpacing current systems. Leaders
          aren't aligned. Good people are leaving. Strategy isn't translating into action.
        </p>
        <p data-reveal>
          We've led organizations ourselves, so we know these challenges rarely have a single cause. We
          start by understanding your organization, bringing together different perspectives to help you
          see the whole picture, make confident decisions, and move forward.
        </p>
        <p class="band-cta" data-reveal>
          <a class="btn btn-on-dark" href="/contact/">
            <span class="btn-tri" aria-hidden="true"><Icon name="triangle" size={9} /></span>
            Let's talk
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Book banner. Round 3: blurb and a buy button, at Roz's request. The cover's own
       colors stay inside the cover; the section stays linen and navy. -->
  <section class="section book" aria-labelledby="book-h">
    <div class="container book-inner">
      <div class="book-art" data-reveal>
        <Image
          class="book-cover"
          src={bookCover}
          alt="The Engagement Dilemma by Dr. Roz Cohen, book cover"
          widths={[220, 298]}
          sizes="220px"
        />
        <!-- TODO: confirm with Roz. Swap for a photo of Roz with the book if she has one. -->
        <img
          class="book-photo"
          src="/media/img/team/roz-cohen.jpg"
          alt="Roz Cohen, PhD"
          width="800"
          height="800"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="book-copy">
        <p class="eyebrow" data-reveal>From our CEO</p>
        <div class="book-title" data-reveal>
          <h2 id="book-h"><cite>The Engagement Dilemma</cite></h2>
          <p class="book-subtitle">How to Create a Culture of Belonging</p>
        </div>
        <p class="book-byline" data-reveal>By Roz Cohen, PhD.</p>
        <div class="book-blurb" data-reveal>
          <p>Ping-pong tables don’t create culture. Annual surveys aren’t listening. And “we’re like a family here” is not the same as care.</p>
          <p>In The Engagement Dilemma, I share the research and real-world lessons behind what makes people want to stay: trust, clarity, and managers who know how to lead. You’ll find practical tools for hiring, onboarding, developing, and keeping your people, plus a tear sheet at the end of every chapter so you can put it to work tomorrow.</p>
          <p>No trust fall required.</p>
        </div>
        <p class="book-action" data-reveal>
          <a class="btn btn-secondary" href="https://www.amazon.com/dp/1969679085" target="_blank" rel="noopener">
            Get the book <Icon name="arrow" size={15} /><span class="sr-only"> (opens Amazon in a new tab)</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Band 3: two ways to work together. Same faded tile ground as About's beliefs band,
       drifting very slowly. -->
  <section class="section section-gray has-bg has-glow ways-band" aria-labelledby="two-ways-h">
    <div class="section-bg section-bg-drift" aria-hidden="true" data-drift="90" data-drift-travel="2">
      <Image src={gen("foundation")} alt="" widths={[800, 1400, 2000]} sizes="100vw" />
    </div>
    <MosaicGlow position="top-right" seed={157} />
    <div class="container">
      <TwoWays level={2} cta />
    </div>
  </section>

  <!-- Band 4: Co-Founders -->
  <section class="section us" aria-labelledby="us-h">
    <div class="container">
      <h2 id="us-h" class="us-h" data-reveal>Co-Founders</h2>
      <Founders variant="compact" level={3} />
      <p class="band-cta" data-reveal>
        <a class="btn btn-primary" href="/contact/">
          <span class="btn-tri" aria-hidden="true"><Icon name="triangle" size={9} /></span>
          Let's talk
        </a>
      </p>
    </div>
  </section>

  <CtaBand heading="Do the pieces not quite fit?" />
</Base>

<style>
  /* Band 1 */
  /* Round 3: shorter. Auto height with generous padding on mobile, 78svh from 1024. */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 9rem 5rem;
    overflow: hidden;
    isolation: isolate;
  }
  @media (min-width: 1024px) {
    .hero { min-height: 78svh; padding-block: clamp(9rem, 16vh, 11rem) clamp(5rem, 10vh, 7rem); }
  }
  .hero-media { position: absolute; inset: -8% 0; z-index: -1; }
  .hero-media video { width: 100%; height: 100%; object-fit: cover; }
  .hero-scrim { position: absolute; inset: 0; background: var(--scrim); }
  .hero-wash { position: absolute; inset: 0; overflow: hidden; }
  .hero-wash span { position: absolute; width: 90%; aspect-ratio: 1.4; border-radius: 50%; }
  .hero-wash-navy {
    left: -20%;
    top: -10%;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--color-navy) 8%, transparent), transparent);
  }
  .hero-wash-slate {
    right: -25%;
    bottom: -20%;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--color-slate) 10%, transparent), transparent);
  }
  /* Legibility wash behind the transparent header. */
  .hero-scrim::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 240px;
    background: linear-gradient(180deg, rgba(250, 240, 224, 0.82), rgba(250, 240, 224, 0));
  }

  .hero-inner { position: relative; display: grid; gap: clamp(1rem, 2vw, 1.5rem); }
  .hero-inner > * { max-width: 50rem; margin: 0; }
  /* Linen glow so the type reads over the moving tiles. */
  .hero-inner::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: -6%;
    top: -22%;
    width: min(60rem, 100%);
    height: 144%;
    background: radial-gradient(ellipse at 35% 50%, rgba(250, 240, 224, 0.9) 20%, rgba(250, 240, 224, 0) 70%);
    pointer-events: none;
  }
  .hero-inner h1,
  .hero-inner .lead {
    text-shadow:
      0 0 12px rgba(250, 240, 224, 0.95),
      0 0 28px rgba(250, 240, 224, 0.9),
      0 0 56px rgba(250, 240, 224, 0.75);
  }
  .hero-inner h1 { font-size: var(--step-3); line-height: 1.08; letter-spacing: -0.01em; max-width: 16ch; }
  @media (min-width: 1024px) { .hero-inner h1 { font-size: var(--step-4); } }
  .hero-inner .lead { max-width: 44ch; }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: var(--space-8) !important;
  }

  .scroll-cue {
    position: absolute;
    left: max(var(--gutter), calc((100% - var(--content-max)) / 2 + var(--gutter)));
    bottom: 2rem;
    margin: 0;
  }
  @media (max-height: 700px) { .scroll-cue { display: none; } }

  /* Band 2 */
  .statement h2,
  .statement p { color: inherit; }
  .statement-inner { display: grid; gap: clamp(2.5rem, 5vw, 4.5rem); }
  .statement-h { font-size: var(--step-4); line-height: 1.08; letter-spacing: -0.01em; max-width: 24ch; }
  .statement-body { font-size: var(--step-1); line-height: 1.55; max-width: 56ch; }
  /* Mobile: the cluster sits above the text at half height. */
  .statement-art { width: min(55%, 240px); }
  .statement-art :global(svg) { width: 100%; height: auto; }
  @media (min-width: 1024px) {
    .statement-inner { grid-template-columns: 5fr 7fr; align-items: center; column-gap: clamp(3rem, 6vw, 6rem); }
    .statement-h { grid-column: 1 / -1; }
    .statement-art { width: 100%; max-width: 420px; }
  }
  .statement .band-cta { margin-top: clamp(2.5rem, 5vw, 3.5rem); }

  /* Book banner */
  /* Images left, copy right from 768. Stacked on mobile, cover first. */
  .book-inner { display: grid; gap: clamp(2.5rem, 5vw, 5rem); align-items: center; }
  @media (min-width: 768px) { .book-inner { grid-template-columns: 5fr 6fr; } }
  .book-art { display: flex; align-items: flex-end; gap: var(--grid-gap); }
  /* The cover is 298px wide: never wider than 220 so it stays at 1.35x. */
  .book-cover {
    flex: none;
    width: min(46%, 220px);
    height: auto;
    border-radius: 2px;
    box-shadow: 0 2px 4px rgba(20, 35, 58, 0.12), 0 22px 44px -18px rgba(20, 35, 58, 0.45);
    transform: rotate(-2deg);
    transition: transform 0.4s var(--ease-out-expo);
  }
  .book-art:hover .book-cover { transform: rotate(0); }
  .book-photo {
    flex: none;
    width: min(42%, 200px);
    aspect-ratio: 4 / 5;
    height: auto;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: var(--radius-tile) 0 var(--radius-tile) 0;
  }
  .book-copy { display: grid; gap: var(--space-20); }
  .book-copy p { margin: 0; }
  .book-title { display: grid; gap: var(--space-8); }
  .book-copy h2 { font-size: var(--step-4); line-height: 1.08; letter-spacing: -0.01em; }
  .book-copy cite { font-style: italic; }
  .book-subtitle { font-size: var(--step-1); font-weight: 500; color: var(--color-navy); }
  .book-byline { font-size: var(--step-0); font-weight: 500; }
  .book-blurb { font-size: var(--step-0); max-width: 52ch; }
  .book-blurb p + p { margin-top: 1em; }
  .book-action { margin-top: var(--space-8) !important; }

  /* Band 3 */
  .section-bg-drift { inset: -3%; }

  /* Band 4 */
  .us-h { font-size: var(--step-4); line-height: 1; margin-bottom: clamp(3rem, 6vw, 5rem); }

  .band-cta { margin-top: clamp(3rem, 6vw, 4.5rem); }
</style>
