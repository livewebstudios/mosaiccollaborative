---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import TwoWays from "../components/TwoWays.astro";
import Founders from "../components/Founders.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
import { team } from "../data/team";

// Round 2 (Oct 2026): one scroll of five bands plus the closing band. Much less content,
// much more white space.
const title = "The Mosaic Collaborative: Strategy & Leadership Consulting";
const description =
  "Strategy, leadership, and organizational consulting for companies at critical inflection points. We align the pieces so your business thrives.";

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: site.url,
  slogan: site.tagline,
  description,
  logo: new URL("/og.jpg", site.url).href,
  ...(site.email.startsWith("TODO") ? {} : { email: site.email }),
  areaServed: { "@type": "Country", name: "United States" },
  founder: team.map((m) => ({
    "@type": "Person",
    name: m.name,
    jobTitle: m.title,
  })),
};
---

<Base title={title} description={description} path="/" schema={schema}>
  <!-- Band 1: first screen -->
  <section class="hero" aria-labelledby="hero-h" data-parallax-scope>
    <div class="hero-media" aria-hidden="true">
      <video
        data-autoplay
        data-hold="4"
        data-rate="0.85"
        data-parallax="0.12"
        muted
        playsinline
        preload="metadata"
        poster="/media/video/mosaic_hero_light_tiles_720p-poster.jpg"
        width="1280"
        height="720"
      >
        <source src="/media/video/mosaic_hero_light_tiles_720p.webm" type="video/webm" />
        <source src="/media/video/mosaic_hero_light_tiles_720p.mp4" type="video/mp4" />
      </video>
      <div class="hero-scrim"></div>
    </div>

    <div class="container hero-inner">
      <h1 id="hero-h" data-reveal>We align the <em class="emphasis">pieces</em>, your business thrives.</h1>
      <p class="lead" data-reveal style="--reveal-delay:140ms">
        Strategy, leadership, and organizational consulting for companies at critical inflection points.
      </p>
      <p class="hero-actions" data-reveal style="--reveal-delay:280ms">
        <a class="btn btn-primary" href="/contact/">
          <span class="btn-tri" aria-hidden="true"><Icon name="triangle" size={9} /></span>
          Let's talk
        </a>
        <a class="btn btn-secondary" href="/services/">Explore our services</a>
      </p>
    </div>

    <p class="scroll-cue" aria-hidden="true">
      <span class="scroll-cue-line"></span>
    </p>
  </section>

  <!-- Band 2: the big statement. Plain navy without JS or under reduced motion;
       otherwise it blends in from linen as it scrolls up (initStatement in motion.ts). -->
  <section class="section section-dark statement" aria-labelledby="statement-h" data-statement>
    <div class="container statement-inner">
      <h2 id="statement-h" class="statement-h" data-reveal>
        Whether you're pursuing an opportunity or responding to a challenge, we help you prepare your
        organization for what's next.
      </h2>
      <div class="statement-body">
        <p data-reveal>
          We work with small and mid-sized companies facing challenges that don't have obvious answers.
          AI is reshaping the workforce. Growth has stalled, or is outpacing current systems. Leaders
          aren't aligned. Good people are leaving. Strategy isn't translating into action.
        </p>
        <p data-reveal>
          We've led organizations ourselves, so we know these challenges rarely have a single cause. We
          start by understanding your organization, bringing together different perspectives to help you
          see the whole picture, make confident decisions, and move forward.
        </p>
        <p class="band-cta" data-reveal>
          <a class="btn btn-on-dark" href="/contact/">
            <span class="btn-tri" aria-hidden="true"><Icon name="triangle" size={9} /></span>
            Let's talk
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Book banner: credibility, not a sale. No price, no store links, no button. -->
  <section class="section book" aria-labelledby="book-h">
    <div class="container book-inner">
      <div class="book-art" aria-hidden="true" data-reveal>
        <!-- TODO: confirm with Roz. Book cover image (2:3) goes here. -->
        <div class="book-placeholder book-cover"></div>
        <!-- TODO: confirm with Roz. Photo of Roz with the book (4:5) goes here. -->
        <div class="book-placeholder book-photo"></div>
      </div>
      <div class="book-copy">
        <p class="eyebrow" data-reveal>From our founder</p>
        <h2 id="book-h" data-reveal><cite>The Engagement Dilemma</cite></h2>
        <p class="book-byline" data-reveal>By Roz Cohen, PhD.</p>
        <!-- TODO: confirm with Roz: one-line description of the book, and whether to link anywhere. -->
      </div>
    </div>
  </section>

  <!-- Band 3: two ways to work together -->
  <section class="section section-gray ways-band" aria-labelledby="two-ways-h">
    <div class="container">
      <TwoWays level={2} cta />
    </div>
  </section>

  <!-- Band 4: Us -->
  <section class="section us" aria-labelledby="us-h">
    <div class="container">
      <h2 id="us-h" class="us-h" data-reveal>Us</h2>
      <Founders variant="compact" level={3} />
      <p class="band-cta" data-reveal>
        <a class="btn btn-primary" href="/contact/">
          <span class="btn-tri" aria-hidden="true"><Icon name="triangle" size={9} /></span>
          Let's talk
        </a>
      </p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Band 1 */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(10rem, 18vh, 13rem) clamp(6rem, 12vh, 9rem);
    overflow: hidden;
    isolation: isolate;
  }
  .hero-media { position: absolute; inset: -8% 0; z-index: -1; }
  .hero-media video { width: 100%; height: 100%; object-fit: cover; }
  .hero-scrim { position: absolute; inset: 0; background: var(--scrim); }
  /* Legibility wash behind the transparent header. */
  .hero-scrim::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 240px;
    background: linear-gradient(180deg, rgba(250, 240, 224, 0.82), rgba(250, 240, 224, 0));
  }

  .hero-inner { position: relative; display: grid; gap: clamp(1.5rem, 3vw, 2.25rem); }
  .hero-inner > * { max-width: 50rem; margin: 0; }
  /* Linen glow so the type reads over the moving tiles. */
  .hero-inner::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: -6%;
    top: -22%;
    width: min(60rem, 100%);
    height: 144%;
    background: radial-gradient(ellipse at 35% 50%, rgba(250, 240, 224, 0.9) 20%, rgba(250, 240, 224, 0) 70%);
    pointer-events: none;
  }
  .hero-inner h1,
  .hero-inner .lead {
    text-shadow:
      0 0 12px rgba(250, 240, 224, 0.95),
      0 0 28px rgba(250, 240, 224, 0.9),
      0 0 56px rgba(250, 240, 224, 0.75);
  }
  .hero-inner h1 { font-size: var(--step-5); line-height: 0.98; letter-spacing: -0.03em; max-width: 14ch; }
  .hero-inner h1 em { font-style: normal; }
  .hero-inner .lead { max-width: 44ch; }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: var(--space-8) !important;
  }

  .scroll-cue {
    position: absolute;
    left: max(var(--gutter), calc((100% - var(--content-max)) / 2 + var(--gutter)));
    bottom: 2rem;
    margin: 0;
  }
  @media (max-height: 700px) { .scroll-cue { display: none; } }

  /* Band 2 */
  .statement h2,
  .statement p { color: inherit; }
  .statement-inner { display: grid; gap: clamp(3rem, 6vw, 5rem); }
  .statement-h { font-size: var(--step-4); line-height: 1.04; letter-spacing: -0.028em; max-width: 24ch; }
  .statement-body { font-size: var(--step-1); line-height: 1.55; max-width: 56ch; }
  @media (min-width: 1024px) {
    .statement-inner { grid-template-columns: repeat(12, 1fr); }
    .statement-h { grid-column: 1 / -1; }
    .statement-body { grid-column: 6 / -1; }
  }
  .statement .band-cta { margin-top: clamp(2.5rem, 5vw, 3.5rem); }

  /* Book banner */
  .book-inner { display: grid; gap: clamp(3rem, 6vw, 6rem); align-items: center; }
  @media (min-width: 768px) { .book-inner { grid-template-columns: 6fr 5fr; } }
  .book-art { display: flex; align-items: flex-end; gap: var(--grid-gap); max-width: 30rem; }
  .book-placeholder {
    background: var(--color-linen-dark);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
  }
  .book-cover { flex: 2; aspect-ratio: 2 / 3; }
  .book-photo { flex: 2.4; aspect-ratio: 4 / 5; }
  .book-copy { display: grid; gap: var(--space-16); }
  .book-copy p { margin: 0; }
  .book-copy h2 { font-size: var(--step-4); line-height: 1; letter-spacing: -0.028em; }
  .book-copy cite { font-style: italic; }
  .book-byline { font-size: var(--step-1); }

  /* Band 4 */
  .us-h { font-size: var(--step-4); line-height: 1; margin-bottom: clamp(3rem, 6vw, 5rem); }

  .band-cta { margin-top: clamp(3rem, 6vw, 4.5rem); }
</style>
