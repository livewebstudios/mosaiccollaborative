---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../data/site";
import { wordCount, externalText, fmtDate } from "../../lib/insights";

export const getStaticPaths = (async () => {
  const posts = await getCollection("insights", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const path = `/insights/${post.id}/`;

const { author, externalUrl, externalLabel, hero } = post.data;
// The link-out button closes the body; a long post also gets it under the title.
const longBody = wordCount(post.body) > 300;
const authorSchema =
  author === site.name
    ? { "@type": "Organization", name: site.name, url: site.url }
    : { "@type": "Person", name: author, worksFor: { "@type": "Organization", name: site.name, url: site.url } };

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    author: authorSchema,
    ...(hero ? { image: new URL(hero, site.url).href } : {}),
    publisher: { "@type": "Organization", name: site.name, url: site.url },
    mainEntityOfPage: site.url + path,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.url + "/" },
      { "@type": "ListItem", position: 2, name: "Insights", item: site.url + "/insights/" },
      { "@type": "ListItem", position: 3, name: post.data.title, item: site.url + path },
    ],
  },
];
---

<Base title={`${post.data.title} | The Mosaic Collaborative`} description={post.data.description} path={path} schema={schema}>
  <article class="post" data-accent={post.data.heroAccent}>
    <header class="section post-head">
      <div class="container post-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/insights/">INSIGHTS</a></li>
            <li aria-current="page">{post.data.category.toUpperCase()}</li>
          </ol>
        </nav>
        <h1 data-reveal>{post.data.title}</h1>
        <p class="lead" data-reveal>{post.data.description}</p>
        <p class="post-meta">
          <span>{author}</span>
          <span aria-hidden="true"> · </span>
          <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
        </p>
        {externalUrl && longBody && (
          <p class="post-ext">
            <a class="btn btn-secondary" href={externalUrl} target="_blank" rel="noopener noreferrer">
              {externalText(externalLabel)} <Icon name="external" size={15} /><span class="sr-only"> (opens in a new tab)</span>
            </a>
          </p>
        )}
      </div>
    </header>

    <div class="section post-body-section">
      <div class="container">
        {hero && (
          <Image class="post-hero" src={hero} alt={post.data.heroAlt ?? ""} width={1600} height={900} />
        )}
        <div class="post-body">
          <Content />
        </div>
        {externalUrl && (
          <p class="post-ext">
            <a class="btn btn-secondary" href={externalUrl} target="_blank" rel="noopener noreferrer">
              {externalText(externalLabel)} <Icon name="external" size={15} /><span class="sr-only"> (opens in a new tab)</span>
            </a>
          </p>
        )}
        <p class="post-back">
          <a class="link-arrow" href="/insights/">All insights <Icon name="arrow" size={15} /></a>
        </p>
      </div>
    </div>
  </article>

  <CtaBand />
</Base>

<style>
  .post-head {
    background: var(--accent-tint);
    padding-top: calc(var(--section-y) + 8.5rem);
  }
  /* Centered in the 1200 track like the header; only the text measure is capped. */
  .post-inner > * { max-width: 52rem; }
  .post-inner h1 { margin-bottom: 1rem; }
  .breadcrumb ol {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: var(--step--1);
    letter-spacing: 0.12em;
  }
  .breadcrumb li + li::before { content: "/"; margin-right: 0.6rem; opacity: 0.45; }
  .breadcrumb a { text-decoration: none; border-bottom: 1px solid var(--rule); }
  .breadcrumb [aria-current="page"] { color: var(--accent-text); }
  .post-meta { font-size: var(--step--1); opacity: 0.75; margin-top: 1.5rem; }

  .post-body { max-width: 62ch; }
  .post-body :global(h2) { font-size: var(--step-2); margin-top: 2.5rem; margin-bottom: 0.75rem; }
  .post-body :global(h3) { font-size: var(--step-1); margin-top: 2rem; margin-bottom: 0.5rem; }
  .post-body :global(ul) { margin: 1.25em 0; padding-left: 1.25em; list-style: disc; }
  .post-body :global(ol) { margin: 1.25em 0; padding-left: 1.25em; list-style: decimal; }
  .post-body :global(li)::marker { color: var(--accent); }
  .post-body :global(li) + :global(li) { margin-top: 0.5em; }
  .post-body :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--accent);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
  }
  .post-body :global(a) { text-decoration: underline; text-underline-offset: 4px; }
  .post-body :global(img) { border-radius: var(--radius-tile) 0 var(--radius-tile) 0; margin: 2rem 0; }
  .post-back { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .post-ext { margin-top: 2rem; }
  .post-body-section :global(.post-hero) {
    width: 100%;
    max-width: 62rem;
    aspect-ratio: 16 / 9;
    height: auto;
    object-fit: cover;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    border-radius: var(--radius-tile) 0 var(--radius-tile) 0;
  }
</style>
