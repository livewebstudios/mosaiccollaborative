---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import CtaBand from "../../components/CtaBand.astro";
import MosaicGlow from "../../components/MosaicGlow.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../data/site";
import { linksOut, externalText, fmtDate } from "../../lib/insights";

const title = "Insights from The Mosaic Collaborative";
const description =
  "Practical thinking on leadership, culture, organizational effectiveness and leading through AI-driven change.";

const posts = (await getCollection("insights", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const categories = [...new Set(posts.map((p) => p.data.category))];


const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: title,
    description,
    url: site.url + "/insights/",
    publisher: { "@type": "Organization", name: site.name, url: site.url },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.url + "/" },
      { "@type": "ListItem", position: 2, name: "Insights", item: site.url + "/insights/" },
    ],
  },
];
---

<Base title={title} description={description} path="/insights/" schema={schema}>
  <section class="section page-hero has-glow" aria-labelledby="insights-h">
    <MosaicGlow position="top-right" seed={173} />
    <div class="container page-hero-inner">
      <p class="eyebrow" data-reveal>Insights</p>
      <h1 id="insights-h" data-reveal>Thinking out loud</h1>
      <p class="lead" data-reveal>
        Practical thinking on leadership, culture, organizational effectiveness and leading through
        AI-driven change.
      </p>
    </div>
  </section>

  <section class="section posts" aria-label="Articles">
    <div class="container">
      {posts.length > 0 ? (
        <>
          {categories.length > 1 && (
            <ul class="category-list" aria-label="Categories">
              {categories.map((c) => <li class="category-chip">{c}</li>)}
            </ul>
          )}
          <ul class="post-grid" data-reveal-stagger="80">
            {posts.map((post) => {
              // Short pieces that live elsewhere (a podcast, a LinkedIn post) link straight out.
              const out = linksOut(post.data.externalUrl, post.body);
              const href = out ? post.data.externalUrl! : `/insights/${post.id}/`;
              return (
                <li class="card post-card" data-accent={post.data.heroAccent} data-reveal>
                  <article>
                    {post.data.hero && (
                      <Image class="post-hero" src={post.data.hero} alt="" width={1600} height={900} loading="lazy" />
                    )}
                    <p class="eyebrow eyebrow-sm">{post.data.category}</p>
                    <h2>
                      <a href={href} {...(out ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                        {post.data.title}
                        {out && (
                          <>
                            {" "}<Icon name="external" size={16} class="post-ext" />
                            <span class="sr-only"> ({externalText(post.data.externalLabel)}, opens in a new tab)</span>
                          </>
                        )}
                      </a>
                    </h2>
                    <p class="post-desc">{post.data.description}</p>
                    <p class="post-meta">
                      <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
                      <span aria-hidden="true"> · </span>
                      <span>{post.data.author}</span>
                    </p>
                  </article>
                </li>
              );
            })}
          </ul>
        </>
      ) : (
        <div class="empty-state" data-reveal>
          <p class="eyebrow">Coming soon</p>
          <p class="text-large">
            We're writing. The first pieces land here shortly.
          </p>
          <p class="measure">
            In the meantime, our custom offerings explain how we think about organizational change, and
            the core services show what that looks like in practice.
          </p>
          <p class="empty-links">
            <a class="link-arrow" href="/services/#custom-offerings">See our custom offerings <Icon name="arrow" size={15} /></a>
            <a class="link-arrow" href="/services/#core-services">See our core services <Icon name="arrow" size={15} /></a>
          </p>
        </div>
      )}
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .page-hero { position: relative; overflow: hidden; padding-top: calc(var(--section-y) + 8.5rem); }
  .page-hero-inner { position: relative; z-index: 1; display: grid; gap: 1rem; }
  /* Centered in the 1200 track like the header; only the text measure is capped. */
  .page-hero-inner > * { max-width: 58rem; }

  .posts { padding-top: 0; }

  .category-list {
    list-style: none;
    margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .category-chip {
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: var(--space-4) var(--space-12);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
  }

  .post-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--grid-gap);
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) { .post-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1200px) { .post-grid { grid-template-columns: repeat(3, 1fr); } }
  .post-card h2 { font-size: var(--step-2); margin: 0.75rem 0 0.75rem; }
  .post-card h2 a { text-decoration: none; }
  /* The title link covers the whole card, so the card is one target. */
  .post-card h2 a::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .post-card :global(.post-ext) { display: inline; vertical-align: baseline; color: var(--accent-text); }
  .post-card :global(.post-hero) {
    width: calc(100% + 2 * clamp(var(--space-20), 2.4vw, var(--space-32)));
    max-width: none;
    margin: calc(-1 * clamp(var(--space-20), 2.4vw, var(--space-32))) calc(-1 * clamp(var(--space-20), 2.4vw, var(--space-32))) var(--space-20);
    aspect-ratio: 16 / 9;
    height: auto;
    object-fit: cover;
  }
  .post-card h2 a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .post-desc { font-size: var(--step--1); }
  .post-meta { font-size: var(--step--1); opacity: 0.7; margin-top: 1rem; }

  .empty-state { display: grid; gap: 1.25rem; max-width: 48rem; }
  .empty-state .text-large { max-width: 16em; }
  .empty-links { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 0.5rem; }
</style>
