---
import { Image, Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import { gen, slugify } from "../lib/gen";
import CtaBand from "../components/CtaBand.astro";
import RowCard from "../components/RowCard.astro";
import TwoWays from "../components/TwoWays.astro";
import MosaicField from "../components/MosaicField.astro";
import MosaicGlow from "../components/MosaicGlow.astro";
import HeroMedia from "../components/HeroMedia.astro";
import Icon from "../components/Icon.astro";
import { services } from "../data/services";
import { journeys } from "../data/journeys";
import { site } from "../data/site";

// Round 1 revisions (Sep 2026): Services now carries both offering types. Custom Offerings
// are the four journeys (their pages keep the /how-we-work/ URLs). Core Services are the
// packaged, a la carte services. How We Work was dropped from the nav and redirects here.
// Family header photos (round 3, Nov 1 revision) are off for now (Jon, Nov 1: "this is
// temporary, I might take that back"). Set to true to bring them back as they were.
const showFamilyMedia = false;

const title = "Leadership Consulting Services | Mosaic Collaborative";
const description =
  "Custom journeys that combine the right mix of services, plus focused core services: diagnostics, workshops and embedded advisors for growing companies.";

// Eyebrow wording (round 3, Jon's call). Roz's doc says "Signature Offerings / Core
// Offerings"; round 1 retired "signature", so the site keeps the names the nav anchors and
// the Two Ways cards use. Swap these two lines if Roz insists.
const CUSTOM_EYEBROW = "Custom Offerings";
const CORE_EYEBROW = "Core Services";

// Journey card tiles, one brand color each (round 3 mapping).
const accentHex: Record<string, string> = {
  navy: "#1E3A5F",
  burgundy: "#8B1A3A",
  gold: "#D4942A",
  moss: "#4E7254",
};

const shortLabel: Record<string, string> = {
  diagnostic: "Diagnostic",
  development: "Development",
  belonging: "Belonging & Inclusion",
  executive: "Executive Partnership",
};

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "OfferCatalog",
    name: "Custom Offerings",
    itemListElement: journeys.map((j) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: j.name,
        description: j.framework,
        url: `${site.url}/how-we-work/${j.slug}/`,
        provider: { "@type": "Organization", name: site.name, url: site.url },
      },
    })),
  },
  ...services.map((family) => ({
    "@context": "https://schema.org",
    "@type": "Service",
    name: family.name,
    serviceType: family.motto,
    description: family.intro,
    provider: { "@type": "Organization", name: site.name, url: site.url },
    areaServed: { "@type": "Country", name: "United States" },
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: family.name,
      itemListElement: family.offerings.map((o) => ({
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: o.name,
          ...(o.description ? { description: o.description } : {}),
        },
      })),
    },
  })),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.url + "/" },
      { "@type": "ListItem", position: 2, name: "Services", item: site.url + "/services/" },
    ],
  },
];
---

<Base title={title} description={description} path="/services/" schema={schema}>
  <section class="section page-hero" aria-labelledby="two-ways-h" data-parallax-scope>
    <HeroMedia />
    <div class="container page-hero-inner">
      <TwoWays level={1} base="" />
    </div>
  </section>

  <!-- Round 3: Roz asked for this in a blue band, in sans-serif. A statement, not a
       section title, so it has no heading of its own. -->
  <section class="section section-dark friction-band" aria-label="Why friction costs">
    <div class="container">
      <p class="friction-text" data-reveal>
        A shift in strategy can expose gaps in structure, people, processes, or systems. A leadership
        change can affect culture and performance. And sometimes several things are happening at once,
        making it hard to know where to start. And there are costs to this kind of friction: missed
        goals, lack of alignment and engagement all hit the bottom line.
      </p>
    </div>
  </section>

  <!-- Custom Offerings -->
  <section id="custom-offerings" class="section section-linen-dark custom has-glow" aria-labelledby="custom-h">
    <MosaicGlow position="top-left" seed={113} />
    <div class="container">
      <div class="section-head">
        <!-- TODO: confirm with Roz: "Custom Offerings / Core Services" vs her doc's "Signature Offerings / Core Offerings" -->
        <p class="eyebrow" data-reveal>{CUSTOM_EYEBROW}</p>
        <h2 id="custom-h" data-reveal>What's going on?</h2>
      </div>
      <!-- TODO: confirm with Roz. The Activate and Reignite lines below are built from her
           pattern and need her sign-off (see solutionLinePending in src/data/journeys.ts). -->
      <ul class="journey-cards" data-reveal-stagger>
        {journeys.map((j) => (
          <li class="piece" data-accent={j.accent} data-reveal>
            <a class="journey-card" href={`/how-we-work/${j.slug}/`}>
              <svg class="journey-rule" viewBox="0 0 100 4" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <line class="draw" x1="0" y1="2" x2="100" y2="2" pathLength="100" />
              </svg>
              <span class="journey-card-media" aria-hidden="true">
                <Picture
                  src={gen(`journey-${j.slug}`)}
                  formats={["avif", "webp"]}
                  alt=""
                  widths={[420, 720]}
                  sizes="(min-width: 1024px) 24vw, (min-width: 768px) 46vw, 92vw"
                  loading="lazy"
                />
              </span>
              <span class="journey-card-art" aria-hidden="true">
                <MosaicField cols={3} rows={3} cell={48} density={0.7} seed={j.number.charCodeAt(1) * 7} palette={[accentHex[j.accent]!]} />
              </span>
              <h3 class="journey-name">{j.name}</h3>
              <p class="journey-line">{j.solutionLine}</p>
              <span class="journey-arrow" aria-hidden="true"><Icon name="arrow" size={20} /></span>
            </a>
          </li>
        ))}
      </ul>
      <p class="band-cta" data-reveal>
        <a class="btn btn-primary" href="/contact/">
          <span class="btn-tri" aria-hidden="true"><Icon name="triangle" size={9} /></span>
          Let's talk
        </a>
      </p>
    </div>
  </section>

  <!-- Core Services -->
  <section id="core-services" class="section core has-glow" aria-labelledby="core-h">
    <MosaicGlow position="bottom-right" size="lg" seed={97} />
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>{CORE_EYEBROW}</p>
        {/* TODO: confirm with Roz. Placeholder for the retired "Focused interventions" headline.
            Roz wrote "Focus services, lasting capability"; the existing wording stays for now. */}
        <h2 id="core-h" data-reveal>Focused services. Lasting capability.</h2>
        <p class="lead" data-reveal>
          These are targeted services with a defined scope and outcome, addressing a specific challenge
          and designed to combine seamlessly with others.
        </p>
      </div>
    </div>

    <div class="container services-layout">
      <nav class="subnav" aria-label="Core service families" data-subnav>
        <p class="eyebrow-plain subnav-title">Jump to</p>
        <ul>
          {services.map((family) => (
            <li>
              <a href={`#${family.slug}`} data-subnav-link={family.slug}>
                <span class="subnav-swatch" aria-hidden="true"></span>
                {shortLabel[family.slug]}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="families">
        {services.map((family) => (
          <section
            id={family.slug}
            class="family"
            data-accent="navy"
            data-family={family.slug}
            aria-labelledby={`${family.slug}-h`}
          >
            <div class:list={["family-head", { "has-media": showFamilyMedia }]}>
              <div class="family-head-text">
                <h3 id={`${family.slug}-h`} class="family-name" data-reveal>
                  {family.name}
                  <svg class="family-underline" viewBox="0 0 100 2" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                    <line class="draw" x1="0" y1="1" x2="100" y2="1" pathLength="100" />
                  </svg>
                </h3>
                <p class="family-motto" data-reveal>{family.motto}</p>
                <!-- TODO: confirm with Roz. If "the sentence under the blue band for each service"
                     also means these intros, add is-italic to this class list. -->
                <p class="lead" data-reveal>{family.intro}</p>
                <p class="deliverable-line" data-reveal>
                  <span class="deliverable-label">Deliverable:</span>{" "}
                  <span class="deliverable-value">{family.deliverable}</span>
                </p>
              </div>
              {showFamilyMedia && (
                <div class="family-media" aria-hidden="true" data-reveal data-seat="tilt">
                  <Picture
                    src={gen(`family-${family.slug}`)}
                    formats={["avif", "webp"]}
                    alt=""
                    widths={[480, 900]}
                    sizes="(min-width: 1024px) 26vw, 92vw"
                    loading="lazy"
                  />
                </div>
              )}
            </div>

            <ul class="offering-grid" data-count={family.offerings.length} data-reveal-stagger>
              {family.offerings.map((offering) => (
                <li data-reveal>
                  <RowCard
                    accent="navy"
                    layout="row"
                    level={4}
                    seed={offering.name}
                    title={offering.name}
                    meta={offering.duration}
                    line={offering.description}
                    href={`/contact/?service=${slugify(offering.name)}`}
                    actionLabel="Let's talk"
                    srLabel={`about ${offering.name}`}
                  >
                    <Image
                      slot="line"
                      class="offering-photo"
                      src={gen(`offer-${slugify(offering.name)}`)}
                      alt=""
                      widths={[480, 960]}
                      sizes="(min-width: 1024px) 26vw, 90vw"
                      format="jpg"
                      quality={78}
                      loading="lazy"
                    />
                    <ul slot="bullets">
                      {offering.includes.map((item) => <li>{item}</li>)}
                    </ul>
                  </RowCard>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <CtaBand heading="Ready to explore what's possible?" />
</Base>

<style>
  .page-hero { position: relative; overflow: hidden; isolation: isolate; padding-top: calc(var(--section-y) + 8.5rem); }
  .page-hero-inner { position: relative; z-index: 1; display: grid; gap: 1rem; }
  /* Same legibility treatment as the Home hero: a linen glow behind the heading and
     lead, plus a soft linen halo on the type, so it reads over the moving tiles. */
  .page-hero :global(.two-ways-head) { position: relative; }
  .page-hero :global(.two-ways-head)::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: -6%;
    top: -30%;
    width: min(60rem, 100%);
    height: 160%;
    background: radial-gradient(ellipse at 35% 50%, rgba(250, 240, 224, 0.9) 20%, rgba(250, 240, 224, 0) 70%);
    pointer-events: none;
  }
  .page-hero :global(.two-ways-head h1),
  .page-hero :global(.two-ways-head .lead) {
    text-shadow:
      0 0 12px rgba(250, 240, 224, 0.95),
      0 0 28px rgba(250, 240, 224, 0.9),
      0 0 56px rgba(250, 240, 224, 0.75);
  }

  /* Friction band: Inter italic (Roz, Nov 3), one paragraph, centered block. */
  .friction-text {
    margin: 0 auto;
    max-width: 62ch;
    font-family: var(--font-sans);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--color-linen);
  }
  @media (min-width: 768px) { .friction-text { font-size: var(--step-2); line-height: 1.45; } }

  #custom-offerings, #core-services { scroll-margin-top: 6rem; }
  .section-head { max-width: 60ch; margin-bottom: clamp(2rem, 4vw, 3rem); display: grid; gap: 0.75rem; }

  /* Custom offerings: four journey cards, one line at 1024+, two by two at 768. */
  .journey-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--grid-gap);
  }
  @media (min-width: 768px) { .journey-cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .journey-cards { grid-template-columns: repeat(4, 1fr); } }
  /* The li carries piece-lift, so the halo is not clipped by the card's overflow. */
  .journey-cards > li { display: flex; border-radius: var(--radius-tile); }
  /* Hover (Jon, Nov 1): the card grows a touch as it lifts, and its shadow deepens. */
  .journey-cards > li.piece::after {
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--accent) var(--halo), transparent),
      0 22px 44px -18px color-mix(in oklab, var(--color-navy) 55%, transparent);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .journey-cards > li.piece:hover { transform: translateY(var(--lift-y)) scale(1.03); }
  }

  /* The whole card is the link. Color comes from the heading, the 4px top rule, the
     round 1 image and its tint; never a full color fill (round 3, Nov 1 revision).
     Layers, back to front: image, 10% accent tint, linen scrim, tile cluster, text.
     The text sits at the foot of the card, on the 0.92 end of the scrim, so the
     image reads clearly above it and body copy keeps AA.
     Round 4: RowCard surface tokens (hairline, radius, piece-lift halo on ::after) but
     not its row layout; the top rule is an SVG line that grout-draws. */
  .journey-card {
    --scrim-o: 1;
    --card-min: clamp(22rem, 34vw, 28rem);
    --card-pad: clamp(var(--space-24), 2.4vw, var(--space-32));
    --card-pad-end: clamp(3.5rem, 5vw, 4.5rem);
    /* Containing block for the image, scrim, rule and tiles, so overflow and the
       rounded corners clip them (this came from .surface before round 4). */
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    min-height: var(--card-min);
    overflow: hidden;
    isolation: isolate;
    padding: var(--card-pad);
    padding-bottom: var(--card-pad-end);
    text-decoration: none;
    color: var(--color-ink);
    background: var(--color-linen);
    border: 1px solid color-mix(in oklab, var(--accent) 30%, transparent);
    border-radius: var(--radius-tile);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.85), 0 1px 2px color-mix(in oklab, var(--color-navy) 6%, transparent);
  }
  .journey-rule {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    height: 4px;
    overflow: visible;
  }
  .journey-rule line { stroke: var(--accent); stroke-width: 4; }
  .journey-card-media {
    position: absolute;
    inset: 0;
    z-index: -3;
    pointer-events: none;
  }
  .journey-card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-out-expo);
  }
  /* Tint pulls each image toward its journey color (the reignite image is burgundy,
     the card is moss), so nothing was regenerated. */
  .journey-card-media::after,
  .journey-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .journey-card-media::after { background: color-mix(in oklab, var(--accent) 10%, transparent); }
  .journey-card::before {
    z-index: -2;
    background: linear-gradient(180deg, rgba(250, 240, 224, 0.55) 0%, rgba(250, 240, 224, 0.92) 70%);
    opacity: var(--scrim-o);
    transition: opacity 600ms var(--ease-out-expo);
  }
  .journey-card:hover,
  .journey-card:focus-visible { --scrim-o: 0.95; }
  @media (prefers-reduced-motion: no-preference) {
    .journey-card:hover .journey-card-media :global(img),
    .journey-card:focus-visible .journey-card-media :global(img) { transform: scale(1.03); }
  }
  .journey-card-art {
    position: absolute;
    z-index: -1;
    right: -6px;
    bottom: -6px;
    width: 144px;
    opacity: 0.35;
    pointer-events: none;
    mask-image: radial-gradient(circle at 100% 100%, #000 35%, transparent 72%);
  }
  .journey-card-art :global(svg) { width: 100%; height: auto; }
  .journey-name {
    margin-top: auto;
    font-size: var(--step-3);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--accent-display);
  }
  .journey-line { margin: 0; font-size: var(--step-0); }
  /* Two or more across (Roz, Nov 3): each card spans three rows (open top, heading,
     line) and the li and the card subgrid them, so the headings share a line across each
     row of cards and the line text starts together beneath, whichever card has the
     longest text. One column has nothing to align, so it keeps the flex stack. */
  @media (min-width: 768px) {
    .journey-cards { grid-auto-rows: 1fr auto auto; }
    .journey-cards > li { display: grid; grid-row: span 3; grid-template-rows: subgrid; grid-template-columns: minmax(0, 1fr); row-gap: 0; }
    .journey-card { grid-row: span 3; display: grid; grid-template-rows: subgrid; grid-template-columns: minmax(0, 1fr); row-gap: 0; }
    /* A subgrid's own min-height does not size the shared rows, so this in-flow spacer
       carries it: it spans all three rows and the open top row takes up the slack. */
    .journey-card::after {
      content: "";
      grid-row: 1 / span 3;
      grid-column: 1;
      min-height: calc(var(--card-min) - var(--card-pad) - var(--card-pad-end) - 2px); /* less the 1px border, top and bottom */
      pointer-events: none;
    }
    .journey-name { grid-area: 2 / 1; align-self: end; margin-top: 0; }
    .journey-line { grid-area: 3 / 1; align-self: start; margin-top: var(--space-12); }
  }
  .journey-arrow {
    position: absolute;
    right: clamp(var(--space-20), 2.2vw, var(--space-32));
    bottom: clamp(var(--space-20), 2.2vw, var(--space-24));
    color: var(--accent-text);
    transition: transform 0.25s var(--ease-out-expo);
  }
  .journey-card:hover .journey-arrow,
  .journey-card:focus-visible .journey-arrow { transform: translateX(4px); }
  .band-cta { margin-top: clamp(3rem, 6vw, 4.5rem); }

  /* Core services */
  .services-layout { display: grid; gap: clamp(2rem, 4vw, 4rem); }
  @media (min-width: 1024px) { .services-layout { grid-template-columns: 3fr 9fr; align-items: start; } }

  /* Sticky in page nav, desktop only. On mobile the families simply follow each other. */
  .subnav { display: none; }
  @media (min-width: 1024px) {
    .subnav { display: block; position: sticky; top: 11rem; }
  }
  .subnav-title { margin-bottom: 1rem; }
  .subnav ul { list-style: none; margin: 0; padding: 0; }
  .subnav li + li { margin-top: 0.35rem; }
  .subnav a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0;
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--color-ink);
    /* 0.7 keeps the resting links above 4.5:1 on linen. */
    opacity: 0.7;
    border-left: 2px solid transparent;
    padding-left: 0.9rem;
    transition: opacity 0.3s var(--ease-out-expo), border-color 0.3s var(--ease-out-expo);
  }
  .subnav a:hover { opacity: 1; }
  .subnav a.is-active { opacity: 1; font-weight: 500; border-left-color: var(--color-navy); }
  .subnav-swatch {
    width: 10px;
    height: 10px;
    flex: none;
    background: var(--color-navy);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  .families { display: grid; gap: clamp(4rem, 8vw, 7rem); }
  .family { scroll-margin-top: 10rem; }
  /* Family header band (round 3, Nov 1 revision): text left, the round 1 image right,
     fading into the text from its left edge. Stacked under 768, image after the text. */
  .family-head {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: center;
    margin-bottom: clamp(2rem, 3.5vw, 3rem);
  }
  @media (min-width: 768px) { .family-head.has-media { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); } }
  .family-head-text { max-width: 60ch; display: grid; gap: 0.75rem; }
  .family-media {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius-tile);
  }
  .family-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .family-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(250, 240, 224, 0.7) 0%, rgba(250, 240, 224, 0) 45%);
  }
  .family-name { font-size: var(--step-3); line-height: 1.08; letter-spacing: -0.01em; }
  /* Grout-drawn underline under the family name (round 4). */
  .family-underline { display: block; width: 4.5rem; height: 2px; margin-top: 0.6rem; overflow: visible; }
  .family-underline line { stroke: var(--color-burgundy); stroke-width: 2; }
  /* The motto is a subline, sized to stay on one line at laptop widths. */
  .family-motto { font-size: var(--step-1); font-weight: 500; color: var(--color-navy); margin: 0; }
  @media (min-width: 1024px) { .family-motto { white-space: nowrap; } }
  /* Off by default; see the TODO on the family intro markup. */
  .family-head .lead.is-italic { font-style: italic; }

  /* Round 4: one RowCard per offering, one per row. The family header carries the
     weight; the rows stay quiet. (If Services reads as a wall, the fallback is two
     columns of layout="compact" cards; not built unless Jon asks.) */
  .offering-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--grid-gap);
  }
  /* Nov 1: a long, bill-shaped picture under each offering's title, one size for all
     sixteen, inside the same padding as the text. Decorative, so alt is empty: the
     title beside it already says what it shows. */
  /* The photo starts at the mark tile's left edge (Jon, Nov 1): it reaches back across
     the mark column and its gap, so its left inset matches the card padding. The mark is
     64px from 1024, 56px below, 48px under 640 (RowCard). */
  .offering-grid { --photo-pull: calc(56px + clamp(1rem, 2.5vw, 2.5rem)); }
  @media (max-width: 639px) { .offering-grid { --photo-pull: calc(48px + clamp(1rem, 2.5vw, 2.5rem)); } }
  @media (min-width: 1024px) { .offering-grid { --photo-pull: calc(64px + clamp(1rem, 2.5vw, 2.5rem)); } }
  .offering-grid :global(.offering-photo) {
    display: block;
    width: calc(100% + var(--photo-pull));
    max-width: none;
    margin-left: calc(-1 * var(--photo-pull));
    height: auto;
    aspect-ratio: 7 / 3;
    object-fit: cover;
    margin-top: 0.6rem;
    border-radius: var(--radius-sm);
  }
  .offering-grid > li { position: relative; isolation: isolate; border-radius: var(--radius-tile); }
  /* A soft pool of brand red that spills out from under each card's left edge (Jon's
     sketch, Nov 1; every family in burgundy, his later call). Not a drop shadow: no
